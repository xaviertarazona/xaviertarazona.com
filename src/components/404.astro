---
import "../styles/global.css";
---

<main class="mx-auto px-6 py-10 md:w-2xl md:py-20">
    <h1 class="text-2xl font-medium mb-2 text-header">
        Couldn't find that page :(
    </h1>
    <p class="text-copy">
        I'm sorry, but the page you're looking for doesn't exist.
    </p>
    <a
        href="/"
        class="text-copy underline underline-offset-2 mt-3 inline-block"
    >
        Go back home
    </a>
</main>
